# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hero source clips (large, not needed at runtime)
*.mp4
nsone_in__.html

# Client-supplied CorelDRAW source. ~70MB of embedded bitmap data that git
# cannot diff and nothing in the build reads — the exported logo in
# public/brand/ is what the site actually uses.
/Race Plate.cdr/
/Race Plate.cdr.zip
*.cdr
