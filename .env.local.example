# Copy this file to .env.local and fill in the values from your Supabase
# project (Settings → API). See docs/admin-setup.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public origin, with no trailing slash. Required for correct
# canonical URLs, sitemap entries and social share images.
# e.g. https://racedynamics.in
#
# THIS MATTERS FOR SEO: leave it unset and every canonical tag, sitemap URL
# and Open Graph image points at whatever Vercel preview hostname built the
# site (or localhost), not the real domain — which splits ranking signals
# across two different URLs for the same page instead of consolidating them.
# Set it on the actual hosting platform (Vercel → Project → Settings →
# Environment Variables), not just in this local file.
NEXT_PUBLIC_SITE_URL=

# Search Console / Bing Webmaster site-verification codes. Both optional —
# see docs/seo-checklist.md for where to get them and why they matter more
# than almost anything else in this file for actually ranking.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
