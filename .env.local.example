# Copy this file to .env.local and fill in the values from your Supabase
# project (Settings → API). See docs/admin-setup.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public origin, with no trailing slash. Required for correct
# canonical URLs, sitemap entries and social share images.
# e.g. https://racedynamics.in
NEXT_PUBLIC_SITE_URL=
